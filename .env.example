# Public HTTPS origin of the PWA. Do not include a trailing slash.
VOICE_PUBLIC_ORIGIN=https://voice.example.com

# Cloudflare Access application identity.
VOICE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
VOICE_ACCESS_AUD=replace-with-access-application-audience
VOICE_ACCESS_EMAIL=owner@example.com

# Optional comma-separated development hostnames in addition to localhost.
VOICE_ADDITIONAL_HOSTS=

# Loopback Tars relay and its high-entropy bearer token.
VOICE_RELAY_URL=http://127.0.0.1:8789/v1/turn
VOICE_RELAY_TOKEN=replace-with-at-least-24-random-characters

# Persistent whisper.cpp server.
VOICE_WHISPER_URL=http://127.0.0.1:8790/inference

# Piper voice model. Keep the adjacent .json metadata file with it.
VOICE_PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx

VOICE_MAX_AUDIO_SECONDS=30
